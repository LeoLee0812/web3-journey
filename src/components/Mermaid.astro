---
// Mermaid 流程图组件（客户端渲染，随明暗主题自动切换配色）
// 用法：<Mermaid chart={`graph LR; A-->B;`} />
interface Props {
  chart: string;
}
const { chart } = Astro.props;
---

<div class="mermaid-wrapper" data-mermaid-src={chart}>
  <pre class="mermaid-placeholder">加载图示中…</pre>
</div>

<script>
  import mermaid from 'mermaid';

  // 根据当前主题决定 mermaid 主题，再统一渲染页面上所有图
  async function renderAll() {
    const nodes = document.querySelectorAll<HTMLElement>('[data-mermaid-src]');
    if (!nodes.length) return;

    const isDark = document.documentElement.dataset.theme !== 'light';
    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default',
      themeVariables: {
        primaryColor: isDark ? '#14342f' : '#d7f5ef',
        primaryTextColor: isDark ? '#e7f0ef' : '#0f2b27',
        primaryBorderColor: '#14b8a6',
        lineColor: '#14b8a6',
        fontFamily:
          "-apple-system, 'PingFang SC', 'Microsoft YaHei', 'Noto Sans SC', sans-serif",
        fontSize: '14px',
      },
    });

    for (const [i, el] of Array.from(nodes).entries()) {
      const src = el.dataset.mermaidSrc || '';
      try {
        const { svg } = await mermaid.render(`mmd-${Date.now()}-${i}`, src);
        el.innerHTML = svg;
      } catch {
        el.innerHTML = `<pre>${src.replace(/[<>&]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;' })[c] || c)}</pre>`;
      }
    }
  }

  renderAll();
  // Starlight 主题切换后重绘
  new MutationObserver(renderAll).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>
